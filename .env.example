# Req-to-Code Environment Configuration

# Application
APP_NAME=Req-to-Code
APP_SUBTITLE=AI Assistant
API_V1_STR=/api
ENVIRONMENT=development

# Database (Default: SQLite; switch to postgresql://user:pass@localhost:5432/req_to_code if needed)
DATABASE_URL=sqlite:///storage/req_to_code.db

# LLM Provider selection: mock | gemini | openai | ollama
# 'mock' works out-of-the-box with zero API keys and realistic sample data
LLM_PROVIDER=mock

# LLM generation settings (read from .env, no hardcoded defaults in code)
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
# Optional: cheaper model for extraction; falls back to main model if not set
# LLM_EXTRACTION_MODEL=gemini-1.5-flash

# Google Gemini API (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# OpenAI API (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Ollama local LLM (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional Neo4j Knowledge Graph (defaults to NetworkX in-memory/JSON fallback if not set)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Max file upload size in MB
MAX_UPLOAD_SIZE_MB=25

# Security & Authentication
JWT_SECRET_KEY=req-to-code-dev-secret-key-32-chars-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Gmail SMTP Configuration for Password Reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-sender-email@gmail.com
SMTP_FROM_NAME=ReqToCode AI
SMTP_TLS=True
FRONTEND_URL=http://localhost:5173
ALLOW_DEV_EMAIL_LOG=True
