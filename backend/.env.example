# Req-to-Code Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Optional individual provider overrides
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

DATABASE_URL=sqlite:///backend/storage/req_to_code.db
ENVIRONMENT=development

# Security & Authentication
JWT_SECRET_KEY=req-to-code-dev-secret-key-32-chars-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Gmail SMTP Configuration for Password Reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-sender-email@gmail.com
SMTP_FROM_NAME=ReqToCode AI
SMTP_TLS=True
FRONTEND_URL=http://localhost:5173
ALLOW_DEV_EMAIL_LOG=True
